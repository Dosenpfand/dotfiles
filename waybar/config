{
    "layer": "top",
    "height": 24,
    "spacing": 0,
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "network",
        "pulseaudio",
        "cpu",
        "memory",
        "temperature",
        "backlight",
        "battery",
        "custom/powerprofile",
        "clock",
        "tray",
        "idle_inhibitor"
    ],
    "hyprland/window": {
        "format": "{}",
        "separate-outputs": true
    },
    "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "format": "{name} {icon}",
        "format-icons": {
            "urgent": "",
            "active": "",
            "default": ""
        },
        "persistent-workspaces": {
            "*": [
                1,
                2,
                3,
                4
            ]
        },
        "sort-by-number": true
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "custom/powerprofile": {
        "exec": "p=$(cat /sys/firmware/acpi/platform_profile); echo \"{\\\"alt\\\":\\\"$p\\\",\\\"tooltip\\\":\\\"$p\\\"}\"",
        "return-type": "json",
        "interval": 10,
        "format": "{icon}",
        "format-icons": {
            "performance": "󰓅",
            "balanced": "󰾅",
            "low-power": "󰾆",
            "quiet": "󰾆",
            "cool": "󰾆"
        }
    },
    "tray": {
        "spacing": 5
    },
    "clock": {
        "format": "{:%Y-%m-%d %H:%M}",
        "interval": 1,
        "calendar": {
            "mode": "month",
            "weeks-pos": "left",
            "format": {
                "today": "<b><u>{}</u></b>",
                "weeks": "<span color='#888888'>W{}</span>"
            }
        },
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%a, %Y-%m-%d %H:%M:%S}"
    },
    "cpu": {
        "interval": 5,
        "format": "{usage}% ",
        "tooltip": false
    },
    "memory": {
        "format": "{}% "
    },
    "temperature": {
        "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 80,
        "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C {icon}",
        "format-icons": [
            "󰉬",
            "",
            "󰉪"
        ]
    },
    "backlight": {
        "on-scroll-up": "brightnessctl s +5%",
        "on-scroll-down": "brightnessctl s 5%-",
        "format": "{percent}% {icon}",
        "format-icons": [
            ""
        ]
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󰃨",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        "format-good": "{capacity}% ",
        "format-full": "{capacity}% {icon}",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "network": {
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "{ifname} 󰊗",
        "tooltip-format-wifi": "{ipaddr} via {gwaddr}",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr} via {gwaddr} 󰊗",
        "format-linked": "{ifname} (No IP) 󰊗",
        "format-disconnected": "Disconnected ⚠",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },
    "pulseaudio": {
        "scroll-step": 5,
        "smooth-scrolling-threshold": 1,
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": "󰖁 {icon} {format_source}",
        "format-muted": "󰖁 {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                "",
                ""
            ]
        },
        "on-click": "if command -v pavucontrol >/dev/null; then pavucontrol; else pwvucontrol; fi",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    }
}
